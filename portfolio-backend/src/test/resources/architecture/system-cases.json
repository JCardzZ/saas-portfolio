    "costUsd": 138.4,
    "findings": [
      {
        "rule": "deployment-missing",
        "kind": "deployment",
        "severity": "error",
        "category": "client",
        "message": "Web · SPA (Angular, React) se desplegaba en una pieza que ya no está en la infraestructura.",
        "suggestion": "Añade a la infraestructura una pieza donde desplegarlo."
      },
      {
        "rule": "rps-cache",
        "kind": "nfr",
        "severity": "warning",
        "category": "cache",
        "message": "Con 3000 peticiones por segundo y sin caché, todas las lecturas llegan a la base de datos.",
        "suggestion": "Elige una caché: Redis para datos por usuario, el borde para lo que es igual para todos."
      },
      {
        "rule": "rps-async",
        "kind": "nfr",
        "severity": "warning",
        "category": "queue",
        "message": "A 3000 peticiones por segundo, el trabajo lento hecho dentro de la petición agota el backend en los picos.",
        "suggestion": "Saca ese trabajo a una cola o a un stream de eventos."
      },
      {
        "rule": "latency-cache",
        "kind": "nfr",
        "severity": "warning",
        "category": "cache",
        "message": "Una p95 de 80 ms deja poco margen para consultar la base de datos en cada petición.",
        "suggestion": "Elige una caché para las lecturas más frecuentes."
      },
      {
        "rule": "latency-edge",
        "kind": "nfr",
        "severity": "warning",
        "message": "Con una p95 de 80 ms, la distancia entre el usuario y la región cuenta.",
        "suggestion": "Sirve lo estático desde una CDN, cerca del usuario."
      },
      {
        "rule": "availability-database",
        "kind": "nfr",
        "severity": "warning",
        "message": "Una disponibilidad del 99.99 % no se sostiene con una sola instancia de base de datos.",
        "suggestion": "Añade una réplica en espera en otra zona."
      },
      {
        "rule": "availability-entry",
        "kind": "nfr",
        "severity": "warning",
        "message": "Para el 99.99 % hacen falta varias réplicas del backend y algo que reparta el tráfico entre ellas.",
        "suggestion": "Pon un balanceador o un API gateway delante del backend."
      },
      {
        "rule": "availability-multi-region",
        "kind": "nfr",
        "severity": "warning",
        "message": "El 99.99 % son menos de 53 minutos de caída al año: la caída de una región entera ya no cabe.",
        "suggestion": "Lleva los datos a una base de datos con réplica en otra región."
      },
      {
        "rule": "users-observability",
        "kind": "nfr",
        "severity": "warning",
        "message": "Con 500000 usuarios, un fallo que no se mide se descubre por las quejas.",
        "suggestion": "Añade monitorización con métricas y alertas."
      },
      {
        "rule": "pci-waf",
        "kind": "nfr",
        "severity": "warning",
        "message": "Un sistema que trata datos de tarjetas expuesto a Internet necesita filtrar el tráfico malicioso.",
        "suggestion": "Añade un cortafuegos de aplicación (WAF) delante."
      },
      {
        "rule": "pci-secrets",
        "kind": "nfr",
        "severity": "warning",
        "message": "Las claves con las que se cifran los datos de tarjetas no pueden vivir en la configuración.",
        "suggestion": "Guárdalas en un gestor de secretos, con rotación."
      },
      {
        "rule": "pci-audit",
        "kind": "nfr",
        "severity": "warning",
        "message": "Hay que poder reconstruir quién accedió a los datos de tarjetas y cuándo.",
        "suggestion": "Añade monitorización y conserva los registros de acceso."
      },
      {
        "rule": "health-secrets",
        "kind": "nfr",
        "severity": "warning",
        "message": "Los datos de salud se cifran, y sus claves no pueden vivir en la configuración.",
        "suggestion": "Guárdalas en un gestor de secretos."
      },
      {
        "rule": "health-identity",
        "kind": "nfr",
        "severity": "warning",
        "category": "auth",
        "message": "El acceso a datos de salud exige identificar a cada persona y poder retirarle el acceso.",
        "suggestion": "Usa un proveedor de identidad gestionado, con segundo factor."
      },
      {
        "rule": "budget",
        "kind": "nfr",
        "severity": "warning",
        "message": "El coste estimado (≈ $138 al mes) supera el presupuesto de $100.",
        "suggestion": "Quita piezas, elige tamaños menores o sube el presupuesto."
      }
    ]
  },
