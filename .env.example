# Variables del entorno local (docker-compose.yml de la raíz). Copia a .env y rellena, o deja
# que ./scripts/dev-up.sh lo cree con secretos generados. El archivo .env nunca va al repositorio.

# Obligatorias. Genera cada una con: openssl rand -base64 32
JWT_SECRET=
ADMIN_CLIENT_SECRET=

# Opcionales
# GEMINI_API_KEY=
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# PRICING_AZURE_ENABLED=true
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=8080
