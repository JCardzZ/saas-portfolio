# Copia este archivo como .env en el servidor, junto a docker-compose.yml, y rellénalo allí.
# El .env real NUNCA va al repositorio (está en .gitignore). Permisos recomendados: chmod 600 .env

# Dominio base: la API se publica en https://api.<DOMAIN>
DOMAIN=

# --- Obligatorias ---
# PostgreSQL 16 con la extensión vector. Formato: jdbc:postgresql://<host>:5432/<base>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
# Clave HMAC de los tokens, en Base64. Genérala con: openssl rand -base64 32
JWT_SECRET=
# Contraseña del cliente de administración (el login de /admin). Genérala con: openssl rand -base64 24
ADMIN_CLIENT_SECRET=
# Primer administrador (correo y contraseña de 12 a 72 caracteres). Solo se usan si aún no hay
# ninguna cuenta; después se pueden quitar. Las demás cuentas se crean desde /admin/users.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Origen público del frontend, sin barra final (varios, separados por comas).
CORS_ALLOWED_ORIGINS=

# --- Opcionales ---
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
ADMIN_CLIENT_ID=admin-ui
# Sin clave, la aplicación arranca y las funciones de IA responden 503.
GEMINI_API_KEY=
# Línea de contacto del CV descargable (datos separados por |). Vacía = no se imprime.
CV_CONTACT=
# Memoria máxima del contenedor del backend.
BACKEND_MEMORY=768m
